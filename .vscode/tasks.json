{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create active file build directory",
            "type": "process",
            "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "New-Item -ItemType Directory -Force -Path '${fileDirname}\\build' | Out-Null"
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/W4",
                "/std:c++20",
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fo${fileDirname}\\build\\${fileBasenameNoExtension}.obj",
                "/Fd${fileDirname}\\build\\${fileBasenameNoExtension}.compiler.pdb",
                "/Fe${fileDirname}\\build\\${fileBasenameNoExtension}.exe",
                "${file}",
                "/link",
                "/DEBUG",
                "/PDB:${fileDirname}\\build\\${fileBasenameNoExtension}.pdb",
                "/ILK:${fileDirname}\\build\\${fileBasenameNoExtension}.ilk"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Create active file build directory",
            "dependsOrder": "sequence",
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
